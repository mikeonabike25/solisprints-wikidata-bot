# Solis Prints Wikidata P973 batch bot — credentials
# Copy to .env and fill in either OAuth1 OR bot-password vars (not both).

# ─── Option 1: OAuth 1.0a ────────────────────────────────────────
# Register at https://meta.wikimedia.org/wiki/Special:OAuthConsumerRegistration/propose
# Required grants: "Edit existing pages" + "High-volume editing"
# Applicable project: wikidatawiki

WIKIMEDIA_CONSUMER_TOKEN=
WIKIMEDIA_CONSUMER_SECRET=
WIKIMEDIA_ACCESS_TOKEN=
WIKIMEDIA_ACCESS_SECRET=

# ─── Option 2: Bot password ──────────────────────────────────────
# Create at https://www.wikidata.org/wiki/Special:BotPasswords
# Underlying account must be autoconfirmed (4 days old + 50 edits).
# Grant the same two scopes.

WIKIDATA_BOT_USERNAME=
WIKIDATA_BOT_PASSWORD=
